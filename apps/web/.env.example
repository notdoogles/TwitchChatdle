# Supabase Postgres connection string. Use the "Transaction pooler" (port 6543)
# connection string from Supabase's project settings -> Database -> Connection string,
# not the direct connection -- serverless functions need pooled connections.
DATABASE_URL=postgresql://REPLACE_WITH_SUPABASE_CONNECTION_STRING

# The Twitch channel this game serves questions from (must match what the
# ingestion worker is logging to the `messages` table).
TWITCH_CHANNEL=your_channel_name

# Display name shown in the page title and UI. Defaults to "Chatdle" if unset.
GAME_NAME=Chatdle

# Message shown when the player wins/loses a round. Defaults to
# "You won!" / "You lost!" if unset.
WINNER_MESSAGE=You won!
LOSER_MESSAGE=You lost!

# Hour of day (0-23) and IANA timezone at which the daily round resets.
# Defaults to 0 (midnight) in America/New_York if unset.
RESET_HOUR=0
RESET_TIMEZONE=America/New_York

# Max number of usernames shown in the guess box's autocomplete list. This is
# just a UX cap (a giant dropdown stops being a useful hint), not a
# performance limit -- the correct answer is always included even if the
# channel has more eligible chatters than this. Defaults to 300 if unset.
USERNAME_HINTS_LIMIT=300

# Caps on individual message length (characters) and word count considered
# eligible for a round. Guards against copypasta walls of text -- a message
# can be unique and readable but still too long to make for a fun round.
# Default to 150 characters / 30 words if unset.
MAX_MESSAGE_LENGTH=150
MAX_MESSAGE_WORDS=30

# Caps the daily answer pool to this channel's top N chatters by eligible
# (unique + intelligible) message count, so an obscure lurker with just
# barely enough messages can't get picked as often as a channel regular.
# Unset means no cap -- every chatter with enough eligible messages is
# eligible, same as before this setting existed.
TOP_CHATTERS_LIMIT=50

# Secret required (via the `x-admin-secret` request header) to call the
# POST /api/game/reroll admin endpoint, which forces today's round to a
# different pick without waiting for the next daily reset. Unset means the
# endpoint refuses every request -- it is never "open" by default.
ADMIN_SECRET=

# Optional: a free Twitch app's Client ID/Secret (dev.twitch.tv/console/apps,
# any redirect URL works since this only uses the client-credentials OAuth
# grant), used to fetch real badge images from Twitch's Helix "Get Chat
# Badges" API for the easy-mode badge hints. Unset means badge hints fall
# back to a plain text label (e.g. "Moderator") instead of an image --
# still fully functional, just less visual.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional sponsor sidebar shown alongside the game (components/AdSidebar.tsx).
# Leave AD_SIDEBAR_IMAGE unset to disable it entirely -- the page renders
# exactly as if the sidebar didn't exist.
AD_SIDEBAR_IMAGE=
AD_SIDEBAR_TEXT=
